[Unit]
Description=Hermes Agent Gateway - StageWhisper member __LABEL__
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__LABEL__
Group=__LABEL__
ExecStart=__PYTHON__ -m hermes_cli.main gateway run --replace
WorkingDirectory=__HERMES_HOME__
Environment="HOME=__HOME_DIR__"
Environment="USER=__LABEL__"
Environment="LOGNAME=__LABEL__"
Environment="PATH=__SERVICE_PATH__"
Environment="VIRTUAL_ENV=__VENV_DIR__"
Environment="HERMES_HOME=__HERMES_HOME__"
EnvironmentFile=-__HERMES_HOME__/.env
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=__LABEL__

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=__HOME_DIR__
ReadWritePaths=__HOME_DIR__
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
